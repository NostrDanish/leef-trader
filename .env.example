# Server-side only (Vercel function api/token-risk.ts). Never prefix with VITE_ — it must not reach the browser bundle.
# TypeSafe API key for the advisory Jev token scam/copycat screen. Leave empty to disable the screen.
TYPESAFE_API_KEY=

# Server-side only (api/_guard.ts). Optional bearer token for the quota-spending
# endpoints (api/jev.ts, api/token-risk.ts). When set, requests must carry
# `Authorization: Bearer <token>`; when unset the guard fails OPEN but the
# per-IP rate limit still applies. Do not set this unless first-party clients
# have a way to obtain the token — the public web app currently calls these
# endpoints without credentials and will gracefully degrade (screen/Jev off).
TRADER_API_TOKEN=

# Public (browser) — SAT/leeftrader contract accounts for the SAT treasury tab.
# Default smartatrader (owner choice).
VITE_SAT_CONTRACT=
VITE_SAT_TOKEN_CONTRACT=
